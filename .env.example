# Read-only futures key is enough (enable reading, disable trading / transfer).
# Do not commit the real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional aliases, if you already use these names:
# BINANCE_API_KEY_TRADE=
# BINANCE_API_SECRET_TRADE=

# NONE = direct. CLASH = HTTP proxy (default http://127.0.0.1:7890).
PROXY_TYPE=NONE
# CLASH_HTTP_PROXY=http://127.0.0.1:7890
